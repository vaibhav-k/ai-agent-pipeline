# Provider selection is automatic: if AZURE_OPENAI_ENDPOINT is set below, the
# pipeline uses Azure OpenAI; otherwise it uses plain OpenAI. Fill in ONE of the
# two sections below and leave the other blank/removed.

# --- Option A: OpenAI ---
# OPENAI_API_KEY=your_api_key_here

# Optional: override the default model (gpt-4o-mini).
# OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Option B: Azure OpenAI ---
# Your Azure OpenAI resource endpoint, e.g. https://<resource-name>.openai.azure.com
AZURE_OPENAI_ENDPOINT=

# The *deployment* name from Azure AI Foundry / Azure OpenAI Studio (not the base
# model name).
AZURE_OPENAI_CHAT_MODEL=

# Auth: set AZURE_OPENAI_API_KEY to authenticate with a key. Leave it unset to
# authenticate with Azure AD instead (DefaultAzureCredential - e.g. `az login`
# locally, or a managed identity in Azure); that path needs the azure-identity
# package, already listed in requirements.txt.
# AZURE_OPENAI_API_KEY=

# Optional: Azure OpenAI API version override. Leave unset to use the library's
# current default.
# AZURE_OPENAI_API_VERSION=
